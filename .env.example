# ---------------------------------------------------------------------------
# Gemini bridge configuration template
# Copy this file to `.env` and fill in YOUR values. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- Authentication cookies (SECRETS) ---------------------------------------
# These are your gemini.google.com web-session cookies. Anyone holding them
# can act as your Google account. Treat `.env` like a password file.
#
# How to get them:
#   1. In Chrome, open https://gemini.google.com and sign in.
#   2. Press F12 -> Application -> Storage -> Cookies -> https://gemini.google.com
#   3. Copy the VALUE of __Secure-1PSID  -> GEMINI_1PSID
#   4. Copy the VALUE of __Secure-1PSIDTS -> GEMINI_1PSIDTS
# See docs/cookie-capture.md for details. Use a secondary account if possible.
GEMINI_1PSID=
GEMINI_1PSIDTS=

# Which Chrome profile/account slot to use (0 = default). Usually leave at 0.
GEMINI_AUTHUSER=0

# --- Bridge server ----------------------------------------------------------
# Bind address. 127.0.0.1 keeps the bridge local-only (recommended).
GEMINI_API_HOST=127.0.0.1
# Port the OpenAI-compatible API listens on. Must match baseURL in config\opencode-gemini*.json*
GEMINI_API_PORT=8100
# Shared secret expected as `Authorization: Bearer <key>`. Must match the
# apiKey in the OpenCode config (default gemini-local).
GEMINI_API_KEY=gemini-local

# --- Behavior ---------------------------------------------------------------
# Keep Chrome in charge of cookies copied from its session. Set to 1 only for
# a dedicated session no browser uses; bridge rotation can sign Chrome out.
GEMINI_AUTO_REFRESH=0
# webapi = use cookie-based gemini.webapi backend (default).
# chrome = drive the logged-in Chrome session via vendor\gemini-web-api\extension.
GEMINI_BACKEND=webapi
